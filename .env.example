# Copy this file to ".env" and fill in the values. ".env" is git-ignored: never commit it.
# Without a key (or with ANACHRONISM_OFFLINE=1) the game plays in offline "Historical
# Advisors" mode: your ideas are matched against the curated library instead.
ANTHROPIC_API_KEY=
# The model that rules on ideas. Pick a current model name from Anthropic's documentation
# (https://docs.claude.com); there is deliberately no default in the code.
ANACHRONISM_MODEL=
# Optional: a cheaper, faster model for short clarifying questions (defaults to the above).
ANACHRONISM_FAST_MODEL=
# Optional: stop calling the model after this many tokens in a calendar month (0 = no cap).
ANACHRONISM_MONTHLY_TOKENS=2000000
# Optional: 1 to play offline even with a key; 0 to turn off the debug log of model calls.
ANACHRONISM_OFFLINE=0
ANACHRONISM_LLM_LOG=1
